  {
   "id": "two-sources-around-context",
   "rule": "Q5: sources a, context, b: wf_source_0 is a, wf_source_1 is b (numbered among the non-context entries), both cited; the context entry's own sha line (21) is not pinned.",
   "sources_lines": [
    "    \"a.txt\": {",
    "      \"path\": \"source-text/a.txt\",",
    "      \"sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"",
    "    },",
    "    \"context\": {",
    "      \"path\": \"../../intake/synthetic-hy-001/context.json\",",
    "      \"sha256\": \"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\"",
    "    },",
    "    \"b.txt\": {",
    "      \"path\": \"source-text/b.txt\",",
    "      \"sha256\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"",
    "    }"
   ],
   "expect": {
    "wf_pins": {
     "wf_source_0": [
      17,
      "      \"sha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\""
     ],
     "wf_source_1": [
      25,
      "      \"sha256\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\""
     ]
    },
    "sources_requirement": {
     "done": true,
     "evidence": [
      "wf_source_0",
      "wf_source_1"
     ]
    }
   }
  },
  {
   "id": "context-first-then-a-source",
   "rule": "Q5: when context is the first entry, wf_source_0 is the next entry (line 21), not the context entry (line 17).",
