          "number_format": null,
          "note": null
        },
        {
          "locator": "line 29",
          "text": "Evidence references use the exact CP-1 row identifiers or CP-1A register identifiers from the supplied handoffs. Analytical judgments are explicitly identified as Analyst Interpretation; management estimates and characterizations remain attributed. No framework label supplies additional evidence.",
          "formula": null,
          "cached_value": null,
