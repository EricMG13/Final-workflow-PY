<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; font-src data:; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'">
<title>Deploy VII · Credit Workbench</title><style>:root {
  /* brand: structure and action, never a verdict */
  --rb-navy: #000533;        --rb-blue: #0017E5;
  --rb-blue-hover: #0012B8;  --rb-logo-field: #001AFF;
  /* neutrals */
  --rb-ground: #EEF0F5;  --rb-panel: #FFFFFF;  --rb-head: #F6F7FA;
  --rb-rule: #DDE1EA;    --rb-rule-soft: #EEF0F5;  --rb-select: #E7ECFF;
  --rb-ink: #000533;     --rb-ink-2: #4A5068;  --rb-ink-3: #9AA0B4;
  --rb-on-navy: #FFFFFF; --rb-on-navy-2: #C7CBE0;
  /* signal: meaning for the creditor; never alone */
  --rb-pos: #0E7A46;  --rb-pos-tint: #DCF5E7;  --rb-pos-navy: #7EE2A8;
  --rb-caut: #8A5300; --rb-caut-tint: #FFF1C7; --rb-caut-navy: #FFD166;
  --rb-neg: #B3261E;  --rb-neg-tint: #FBE0DD;  --rb-neg-navy: #FFB4B0;
  --rb-neu: #4A5068;  --rb-neu-tint: #EEF0F5;  --rb-neu-navy: #C7CBE0;
  /* chart */
  --rb-ch-1: #0017E5; /* issuer */   --rb-ch-2: #C4410C; /* comparison */
  --rb-ch-3: #000533; --rb-ch-4: #4A5068; --rb-ch-5: #9AA0B4;
  --rb-ch-grid: #DDE1EA; --rb-ch-track: #EEF0F5; --rb-ch-hatch: 45deg 2/6px;
  /* type */
  --rb-font-display: 'Red Hat Display', system-ui, sans-serif;
  --rb-font-text: 'Red Hat Text', system-ui, sans-serif;
  --rb-font-mono: 'Red Hat Mono', ui-monospace, monospace;
  --rb-fs-page: 20px; --rb-fs-call: 16px; --rb-fs-issuer: 15px;
  --rb-fs-body: 13.5px; --rb-fs-table: 12px; --rb-fs-label: 11px;
  --rb-fs-micro: 10.5px; --rb-lh-body: 1.5; --rb-lh-table: 1.45;
  /* space */
  --rb-s-1: 4px; --rb-s-2: 6px; --rb-s-3: 8px; --rb-s-4: 10px;
  --rb-s-5: 12px; --rb-s-6: 18px; --rb-s-7: 24px;
  /* radius */
  --rb-r-panel: 0; --rb-r-tag: 2px; --rb-r-tile: 3px; --rb-r-nav: 4px;
  /* motion */
  --rb-t-fast: 120ms; --rb-t-base: 180ms; --rb-t-slow: 260ms;
  --rb-ease: cubic-bezier(.2,.7,.2,1);
  /* layout */
  --rb-rail: 56px; --rb-navigator: 236px; --rb-inspector: 300px;
  --rb-call-min: 56px; --rb-target: 24px; --rb-focus: 2px solid var(--rb-blue);
}
@font-face{font-family:"Red Hat Display";font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Red Hat Display";font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Red Hat Text";font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Red Hat Text";font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Red Hat Text";font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Red Hat Mono";font-weight:500;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}
@font-face{font-family:"Red Hat Mono";font-weight:600;font-display:swap;src:url(data:font/woff2;base64,) format("woff2")}/* Direction C shell. Colour, type, space and motion come from the DS-01 --rb-* tokens only.
   Weights follow the embedded fonts: Text 400/500/600, Display 600/700, Mono 500/600. */
*{box-sizing:border-box}
body{margin:0;background:var(--rb-ground);color:var(--rb-ink);font-family:var(--rb-font-text);font-weight:400;font-size:var(--rb-fs-body);line-height:var(--rb-lh-body);font-variant-numeric:tabular-nums}
button,input{font:inherit;color:inherit}
button,a{touch-action:manipulation}
button{cursor:pointer}
a{color:var(--rb-blue);text-underline-offset:3px}
a:hover{color:var(--rb-blue-hover)}
button:focus-visible,a:focus-visible,input:focus-visible,summary:focus-visible,[tabindex]:focus-visible{outline:var(--rb-focus);outline-offset:2px}
h1,h2,h3{font-family:var(--rb-font-display);font-weight:600;line-height:1.2;margin:0}
h1{font-size:var(--rb-fs-page);margin:var(--rb-s-2) 0 var(--rb-s-5);overflow-wrap:anywhere}
h2{font-size:18px}
h3{font-size:15px}
p{margin:var(--rb-s-3) 0}
th{font-weight:600}
kbd{font-family:var(--rb-font-mono);font-weight:500}
.num{font-family:var(--rb-font-mono);font-weight:500}
.muted{color:var(--rb-ink-2)}
.caps{font-size:var(--rb-fs-label);font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--rb-ink-2)}
.eyebrow{font-size:var(--rb-fs-micro);font-weight:600;letter-spacing:.1em}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.skip{position:absolute;left:var(--rb-s-3);top:-100px;background:var(--rb-panel);padding:var(--rb-s-3);z-index:20}
.skip:focus{top:var(--rb-s-3)}

/* Layout */
.app-shell{min-height:100vh;display:grid;grid-template-columns:var(--rb-rail) var(--rb-navigator) minmax(0,1fr) var(--rb-inspector)}
.workbench{min-width:0}
.view-root{padding:var(--rb-s-7) var(--rb-s-7) 48px}
#call-root{display:contents}

/* Rail (DS-07): six destinations, active edge, status dot, tools at the foot */
.icon-rail{height:100vh;position:sticky;top:0;background:var(--rb-navy);color:var(--rb-on-navy);display:flex;flex-direction:column;align-items:center;padding:var(--rb-s-5) 0;gap:var(--rb-s-1);z-index:5}
.brand-mark{width:34px;height:34px;border:1px solid var(--rb-ink-3);display:grid;place-items:center;font-family:var(--rb-font-display);font-weight:700;font-size:13px;margin-bottom:var(--rb-s-6)}
.rail-dests,.rail-foot{display:flex;flex-direction:column;align-items:center;gap:var(--rb-s-1)}
.rail-foot{margin-top:auto}
.rail-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;width:40px;height:36px;border:0;border-left:2px solid transparent;border-radius:var(--rb-r-nav);background:transparent;color:var(--rb-on-navy-2);text-decoration:none;padding:0}
.rail-btn:hover{color:var(--rb-on-navy)}
.rail-btn[aria-current=page]{color:var(--rb-on-navy);border-left-color:var(--rb-on-navy);background:color-mix(in srgb,var(--rb-on-navy) 14%,transparent)}
.rail-btn:focus-visible{outline-color:var(--rb-on-navy)}
.rail-dot{position:absolute;right:5px;top:5px;width:7px;height:7px;border-radius:50%;background:var(--rb-caut-navy);border:1px solid var(--rb-navy)}
#toggle-nav{display:none}

/* Navigator (DS-07) */
.navigator{background:var(--rb-panel);border-right:1px solid var(--rb-rule);height:100vh;position:sticky;top:0;display:flex;flex-direction:column;gap:var(--rb-s-1);padding:var(--rb-s-5) var(--rb-s-4);min-width:0;overflow:auto;font-size:12.5px}
.nav-head{padding:0 var(--rb-s-2) var(--rb-s-1)}
.logo-block{display:flex;align-items:center;gap:var(--rb-s-3);margin-bottom:var(--rb-s-3)}
.logo-img{height:34px;width:auto;display:block}
.logo-word{font-family:var(--rb-font-display);font-weight:600;font-size:13px}
.navigator h2{font-family:var(--rb-font-display);font-weight:700;font-size:var(--rb-fs-issuer);overflow-wrap:anywhere}
.nav-head p{margin:2px 0 0;font-size:var(--rb-fs-label);overflow-wrap:anywhere}
.pathway-chip{display:inline-flex;align-items:center;gap:var(--rb-s-1);margin-top:var(--rb-s-2)!important;background:var(--rb-neu-tint);border-radius:var(--rb-r-tile);padding:1px var(--rb-s-2)}
.search-box{display:flex;align-items:center;gap:var(--rb-s-2);border:1px solid var(--rb-ink-2);border-radius:var(--rb-r-nav);padding:var(--rb-s-2) var(--rb-s-3);margin:var(--rb-s-2) 0 var(--rb-s-1);min-width:0}
.search-box input{flex:1;min-width:0;border:0;background:transparent;padding:0;font-size:12px}
.search-box input:focus-visible{outline:0}
.search-box:focus-within{outline:var(--rb-focus);outline-offset:2px}
.search-box kbd{font-size:var(--rb-fs-micro);border:1px solid var(--rb-rule);border-radius:var(--rb-r-tile);padding:0 var(--rb-s-1);color:var(--rb-ink-2)}
.search-results{min-width:0}
.search-results:empty{display:none}
.search-group{margin:var(--rb-s-2) 0}
.search-hit{display:flex;gap:var(--rb-s-3);align-items:baseline;width:100%;text-align:left;border:0;background:transparent;padding:var(--rb-s-1) var(--rb-s-2);font-size:12px;border-radius:var(--rb-r-tile);overflow-wrap:anywhere}
.search-hit:hover{background:var(--rb-head)}
.search-hit .num{color:var(--rb-ink-2);font-size:var(--rb-fs-micro)}
.nav-tally{display:flex;align-items:center;justify-content:space-between;gap:var(--rb-s-2);padding:var(--rb-s-2) var(--rb-s-2) 2px}
.nav-tally .caps{font-size:var(--rb-fs-micro)}
.chips{display:inline-flex;gap:2px}
.chips button{border:0;background:transparent;font-size:var(--rb-fs-micro);padding:1px var(--rb-s-2);border-radius:var(--rb-r-tile);min-height:var(--rb-target)}
.chips button[aria-pressed=true]{background:var(--rb-navy);color:var(--rb-on-navy)}
.chips .chip-lim{color:var(--rb-caut)}
.chips .chip-pass{color:var(--rb-pos)}
.chips .chip-blocked{color:var(--rb-neg)}
.module-list{display:flex;flex-direction:column;gap:3px;min-height:0;flex-shrink:0}
.module-link{display:grid;grid-template-columns:18px 16px minmax(0,1fr) auto;align-items:center;gap:var(--rb-s-2);padding:0 var(--rb-s-2);min-height:var(--rb-target);border-left:3px solid var(--rb-ink-3);border-radius:var(--rb-r-tile);color:var(--rb-ink);text-decoration:none;font-size:12px}
.module-link:hover{background:var(--rb-head)}
.module-link .n{font-size:var(--rb-fs-micro);color:var(--rb-ink-2)}
.module-link .title{line-height:1.15;overflow-wrap:anywhere}
.module-link .code{font-size:var(--rb-fs-micro);color:var(--rb-ink-2)}
.module-link[aria-current=page]{background:var(--rb-select);font-weight:600}
.module-link.is-unrun .title{font-style:italic}
.outline{margin-top:var(--rb-s-3)}
.outline:empty{display:none}
.outline button{display:block;width:100%;text-align:left;border:0;border-left:2px solid transparent;background:transparent;padding:2px var(--rb-s-3);font-size:12px;min-height:var(--rb-target);overflow-wrap:anywhere}
.outline button[aria-current=true]{border-left-color:var(--rb-blue);font-weight:600}
.nav-foot{margin-top:auto;padding-top:var(--rb-s-3);font-size:var(--rb-fs-label);color:var(--rb-ink-2)}
.nav-foot summary{cursor:pointer;min-height:var(--rb-target);display:flex;align-items:center}
.nav-foot a{display:flex;gap:var(--rb-s-2);align-items:center;color:var(--rb-ink-2);text-decoration:none;padding:2px 0;overflow-wrap:anywhere}

/* Status, provenance and tags: icon plus word, never colour alone (decision 0004 section 6) */
.chip{display:inline-flex;align-items:center;gap:var(--rb-s-1);border-radius:var(--rb-r-tag);padding:1px var(--rb-s-2) 1px var(--rb-s-1);font-weight:600;font-size:11.5px;min-height:22px;white-space:nowrap;color:var(--rb-neu);background:var(--rb-neu-tint)}
.ic{display:inline-flex;vertical-align:middle;flex:none}
.st-pass{color:var(--rb-pos)}.st-lim,.st-stale,.st-candidate{color:var(--rb-caut)}.st-blocked{color:var(--rb-neg)}.st-unrun,.st-na{color:var(--rb-neu)}
.chip.st-pass{background:var(--rb-pos-tint)}.chip.st-lim,.chip.st-stale,.chip.st-candidate{background:var(--rb-caut-tint)}.chip.st-blocked{background:var(--rb-neg-tint)}
.pg{margin-right:3px;vertical-align:-1px;flex:none}
.pg-cited{fill:none;stroke:var(--rb-blue)}.pg-calc{fill:var(--rb-navy)}.pg-calc-line{stroke:var(--rb-on-navy)}.pg-synth{fill:none;stroke:var(--rb-neu)}
.tag{border:1px dashed var(--rb-navy);border-radius:var(--rb-r-tag);padding:0 var(--rb-s-1);font-size:9.5px;letter-spacing:.08em;font-weight:600;text-transform:uppercase}
.pen-tag{display:inline-flex;align-items:center;gap:3px;font-weight:500;color:var(--rb-ink-2);letter-spacing:0;text-transform:none}
.candidate-label{font-size:var(--rb-fs-label);font-weight:600;color:var(--rb-caut);background:var(--rb-caut-tint);padding:var(--rb-s-3) var(--rb-s-5);display:inline-block}

/* Call band (DS-03): navy, 56px minimum, sticky above the canvas */
.call-band{position:sticky;top:0;z-index:4;min-height:var(--rb-call-min);background:var(--rb-navy);color:var(--rb-on-navy);padding:var(--rb-s-4) var(--rb-s-6);display:flex;flex-direction:column;gap:var(--rb-s-3);min-width:0}
.call-top{display:flex;flex-wrap:wrap;align-items:center;gap:var(--rb-s-4);font-size:12px;color:var(--rb-on-navy-2)}
.call-top h2{font-size:var(--rb-fs-call);color:var(--rb-on-navy);overflow-wrap:anywhere}
.call-top .tag{border-color:var(--rb-on-navy-2);color:var(--rb-on-navy)}
.call-top button{margin-left:auto;height:var(--rb-target);padding:0 var(--rb-s-3);border:1px solid var(--rb-on-navy-2);background:transparent;border-radius:var(--rb-r-tile);color:var(--rb-on-navy);font-size:11.5px;font-weight:500}
.call-top button:focus-visible{outline-color:var(--rb-on-navy)}
.call-items{display:flex;flex-wrap:wrap;align-items:stretch;gap:var(--rb-s-3) 0}
.call-item{display:flex;flex-direction:column;gap:3px;padding-right:var(--rb-s-4);margin-right:var(--rb-s-4);border-right:1px solid color-mix(in srgb,var(--rb-on-navy-2) 30%,transparent);min-width:0}
.call-item:last-child{border-right:0}
.call-item .lab{font-size:var(--rb-fs-micro);color:var(--rb-on-navy-2);letter-spacing:.04em;text-transform:uppercase}
.call-item .val{display:inline-flex;align-items:center;gap:var(--rb-s-2)}
.tile{width:30px;height:30px;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--rb-r-tile);font-family:var(--rb-font-mono);font-weight:600;font-size:15px;border:1px dashed color-mix(in srgb,var(--rb-on-navy) 60%,transparent);background:var(--rb-ink-2)}
.call-item .words{display:flex;flex-direction:column;gap:2px}
.call-item .word{font-size:var(--rb-fs-body);font-weight:600;line-height:1.1;white-space:nowrap}
.meter{display:inline-flex;gap:1px}
.meter i{width:7px;height:3px;background:color-mix(in srgb,var(--rb-on-navy) 30%,transparent)}
.meter i.on{background:var(--rb-on-navy)}
.call-band[data-call-state=no-judgement] .word{color:var(--rb-on-navy-2)}
.call-line{margin:0;border-top:1px solid color-mix(in srgb,var(--rb-on-navy-2) 25%,transparent);padding-top:var(--rb-s-2);font-size:12px;line-height:1.45}
.call-line .lab{font-size:var(--rb-fs-micro);letter-spacing:.04em;text-transform:uppercase;font-weight:600;color:var(--rb-on-navy-2);margin-right:var(--rb-s-2)}
.call-note{margin:0;font-size:12px;color:var(--rb-on-navy-2)}

/* Blocks (DS-04): square corners, 11px caps head with owner code, state word, link to the module */
.block{background:var(--rb-panel);border:1px solid var(--rb-rule);margin:var(--rb-s-5) 0;min-width:0;border-radius:var(--rb-r-panel)}
.block-head{display:flex;flex-wrap:wrap;align-items:center;gap:var(--rb-s-3);padding:var(--rb-s-2) var(--rb-s-5);border-bottom:1px solid var(--rb-rule);font-size:var(--rb-fs-label);font-weight:600;letter-spacing:.06em;text-transform:uppercase;min-width:0}
.block-head h3,.block-head h2{font-family:var(--rb-font-text);font-size:var(--rb-fs-label);font-weight:600;letter-spacing:.06em;text-transform:uppercase;overflow-wrap:anywhere}
.block-head .meta{font-weight:500;letter-spacing:0;text-transform:none;color:var(--rb-ink-2)}
.block-head .spacer{flex:1}
.block-head h3{min-width:0}
.block-head .head-end{margin-left:auto;display:inline-flex;align-items:center;gap:var(--rb-s-3);flex:none}
.block-head .full{font-weight:500;letter-spacing:0;text-transform:none;font-size:12px;text-decoration:none}
.block-head .collapse{width:var(--rb-target);height:var(--rb-target);border:0;background:transparent;color:var(--rb-ink-2);display:inline-flex;align-items:center;justify-content:center}
.block-head .expand-link{width:auto;padding:0 var(--rb-s-2);gap:var(--rb-s-1);color:var(--rb-blue);font-size:12px;font-weight:500;letter-spacing:0;text-transform:none}
.block-head .hint,.block-head .pinned,.block-head .summary{font-weight:400;letter-spacing:0;text-transform:none;font-size:12px;color:var(--rb-ink-2)}
.block-head .pinned{font-weight:500}
.block-head .summary{overflow-wrap:anywhere;min-width:0}
.block-head .tab-meta{text-align:right}
.block-head.has-tabs{padding:0 var(--rb-s-5) 0 0;gap:var(--rb-s-3);align-items:stretch}
.block-head.has-tabs .tab-meta{align-self:center}

/* Front Page grid (FP 01): Key findings 5fr beside the operating model 7fr, the rest full width */
.front-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:var(--rb-s-4);align-content:start}
.front-grid>.block{grid-column:1/-1;margin:0}
.front-grid>.block.w-five{grid-column:1}
.front-grid>.block.w-seven{grid-column:2}
.beside{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:var(--rb-s-5);align-items:start}
.beside .fig-strip{grid-template-columns:minmax(0,1fr)}
.block-body{padding:var(--rb-s-3) var(--rb-s-5);min-width:0}
.block.state-not_run,.block.state-outside,.block.state-absent,.block.state-condition{color:var(--rb-ink-2)}
.block.state-not_run .block-head,.block.state-outside .block-head,.block.state-absent .block-head,.block.state-condition .block-head,.block.state-collapsed .block-head{border-bottom:0}
.block.state-blocked{border-color:var(--rb-neg)}
.block-note{display:inline-flex;align-items:center;gap:var(--rb-s-2);font-weight:400;font-size:12px;letter-spacing:0;text-transform:none;overflow-wrap:anywhere;min-width:0}
.block.state-not_run .block-note,.block.state-outside .block-note,.block.state-condition .block-note{font-style:normal}
.block-body.prose p{max-width:80ch;margin:var(--rb-s-3) 0;color:var(--rb-ink-2)}
.block-body.prose p.thesis{color:var(--rb-ink);margin:0 0 var(--rb-s-3);padding-bottom:var(--rb-s-3);border-bottom:1px solid var(--rb-rule-soft)}
ol.numbered{list-style:none;margin:0;padding:0}
ol.numbered li{display:grid;grid-template-columns:16px minmax(0,1fr);gap:var(--rb-s-3);padding:5px 0;border-bottom:1px solid var(--rb-rule-soft);line-height:1.45}
ol.numbered .n{font-size:var(--rb-fs-label);color:var(--rb-ink-2);padding-top:2px}
.sw-cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 var(--rb-s-6)}
.sw-head{display:flex;align-items:center;gap:var(--rb-s-1);padding:5px 0;font-size:var(--rb-fs-label);font-weight:600}
.sw-col.strengths .sw-head{color:var(--rb-pos)}.sw-col.weaknesses .sw-head{color:var(--rb-neg)}
.sw-row{display:grid;grid-template-columns:minmax(0,130px) minmax(0,1fr);gap:var(--rb-s-3);padding:4px 0;border-top:1px solid var(--rb-rule-soft);font-size:12.5px;line-height:1.45;color:var(--rb-ink)}
.sw-label{font-weight:600}
.panel{background:var(--rb-panel);border:1px solid var(--rb-rule);margin:var(--rb-s-5) 0}
.page-head{border-bottom:1px solid var(--rb-rule);padding-bottom:var(--rb-s-5);margin-bottom:var(--rb-s-5)}
.page-head .eyebrow{color:var(--rb-blue)}
.empty-state{padding:var(--rb-s-6) 0;color:var(--rb-ink-2);max-width:60ch}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--rb-s-6)}
.summary-grid .block{margin:0}
.text-content{white-space:pre-wrap;overflow-wrap:anywhere}

/* Tables: figures are right-aligned Mono with the provenance glyph before them */
.table-scroll{overflow:auto;max-width:100%;position:relative}
