":"30 Sep 2024"},"nav":[{"module_id":"CP-0","title":"Source readiness","aliases":["CP-PARSE"],"number":1,"in_pathway":true,"color":"#9AA0B4","glyph":"candidate","word":"Candidate"},{"module_id":"CP-1","title":"Canonical data foundation","aliases":[],"number":2,"in_pathway":true,"color":"#0017E5","glyph":"candidate","word":"Candidate"},{"module_id":"CP-1A","title":"Business transaction fact pack","aliases":["CP-2C"],"number":3,"in_pathway":true,"color":"#2B8FD6","glyph":"candidate","word":"Candidate"},{"module_id":"CP-2","title":"Fundamental credit synthesizer","aliases":[],"number":4,"in_pathway":true,"color":"#000533","glyph":"candidate","word":"Candidate"},{"module_id":"CP-4","title":"Legal covenant interpreter","aliases":["CP-4A","CP-4B","CP-4D"],"number":5,"in_pathway":true,"color":"#8A5300","glyph":"candidate","word":"Candidate"},{"module_id":"CP-3","title":"Relative value security selection","aliases":["CP-3A","CP-3B"],"number":6,"in_pathway":true,"color":"#7A3DB8","glyph":"candidate","word":"Candidate"},{"module_id":"CP-5","title":"Evidence trace validator","aliases":["CP-5A"],"number":7,"in_pathway":true,"color":"#9AA0B4","glyph":"candidate","word":"Candidate"},{"module_id":"CP-6","title":"Ic debate challenge","aliases":["CP-6A"],"number":8,"in_pathway":true,"color":"#000533","glyph":"candidate","word":"Candidate"},{"module_id":"CP-MODEL","title":"TransDigm Group Incorporated historical Model and conditional source tables","aliases":[],"number":9,"in_pathway":true,"color":"#9AA0B4","glyph":"candidate","word":"Candidate"}],"report":{"schema_version":"report-view/1","pathway":{"id":"credit_snapshot","title":"TransDigm historical complete credit pathway","question":"Should we own this issuer, in which instrument, and why?","requested_modules":["CP-4","CP-6"],"blocks":["key-findings","company-operating-model","model-chart-strip","capital-structure","financials-credit-metrics","strengths-weaknesses","relative-value","company-profile","transaction-summary","portfolio-fit","committee-challenge","what-changed"]},"call":[{"kind":"fact","label":"Action bias","value_text":"Requires More Work","meter":null,"ref_id":"C1295","direction":null,"line":false}],"call_withheld":null,"blocks":[{"block_id":"key-findings","title":"Key findings","owner":"CP-2","fig_id":null,"tags":[],"state":"populated","kind":"prose","scale":null,"row_header":null,"columns":[],"rows":[],"lines":[{"runs":[{"text":"Assessment \u2014 Analyst Interpretation; confidence Medium: TD Group's installed-base component franchise and improving historical operating cash generation mitigate business risk, but debt-funded shareholder distributions and rising carrying leverage limit creditor benefit from those earnings; retained liquidity, forward refinancing capacity and legal headroom are not established. Basis: CP-1 IS01/IS06, CF22/CF23, K07/K09/K12, BS14/SE03; CP-1A B03/B04/B10, BF01, CT01\u2013CT05.","kind":"text","ref_id":null},{"text":"C740","kind":"fig","ref_id":"C740"}],"label":null,"section":null},{"runs":[{"text":"Thesis \u2014 Analyst Interpretation: Durable replacement demand can support debt service, but the credit case depends on converting that demand into retained cash rather than acquisitions and shareholder payouts, with no assumed sponsor rescue, unrestricted cash offset or repeat refinancing access. Basis: CP-1 CF22/CF24/CF28, K02/K09; CP-1A B03/B04, X01/X02/X04, GT04, CT02/CT03.","kind":"text","ref_id":null},{"text":"C741","kind":"fig","ref_id":"C741"}],"label":null,"section":null}],"chart":null,"figures":[],"tab_label":null,"tabs":[],"note":null,"full_analysis_route":"CP-2","route_label":null,"width":"full","numbered":false,"pinned":false,"meta":null,"summary":null,"groups":[],"base_column":null,"absent_columns":[]},{"block_id":"company-operating-model","title":"Company and operating model","owner":"CP-1A","fig_id":null,"tags":[],"state":"populated","kind":"keyvalue","scale":null,"row_header":"ID / required row","columns":["Category","Located evidence / measure and status","Risk mechanic \u2192 credit implication / limitation"],"rows":[{"row_id":"r0","label":"Company description","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C496","gap_ref":null,"unit_class":"text","state":"known"},{"text":"B01 \u2014 United States aerospace-components business operating through TransDigm Inc.; S1 p.4: \u201cdesigner, producer and supplier of highly engineered aircraft components\u201d; S1 p.1 supplies jurisdiction and headquarters. \u201cLeading\u201d is deliberately not adopted.","prov":"cited","ref_id":"C496","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Specialized components on commercial and military aircraft create installed-base service demand \u2192 assess recurring replacement demand rather than treat all sales as aircraft deliveries. Platform economics are estimates in B04, not guaranteed orders.","prov":"cited","ref_id":"C496","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r1","label":"B02 Product mix","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C497","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Power & Control: actuators, ignition/engine technology, pumps/valves, motors, batteries, sensors, hoists and microwave electronics. Airframe: latches, rods/seals, security/displays, restraints, interiors, lighting, parachutes and testing. Non-aviation: ground restraints, space actuators, gas-turbine controls and heavy-equipment refueling. S1 p.5: \u201cProducts are sold in the original equipment and aftermarket market channels.\u201d CP-1 SG04/SG08/SG09 retain segment sales below.","prov":"cited","ref_id":"C497","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Diverse component families reduce single-product dependency, but segment mix and end-market cycles still affect earnings \u2192 preserve all three segments and do not equate diversification with immunity to aircraft-sector shocks. Individual product revenue/margin shares: Not disclosed.","prov":"cited","ref_id":"C497","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r2","label":"B03 Revenue-channel estimate","cells":[{"text":"Management Language","prov":"cited","ref_id":"C498","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.4: \u201cWe estimate that approximately 55% of our net sales in fiscal year 2024 were generated from the aftermarket\u201d; same page estimates approximately 90% proprietary products. These are issuer estimates, not a new calculation.","prov":"cited","ref_id":"C498","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Proprietary installed parts and replacement demand can support repeat revenue and pricing discretion \u2192 potentially more durable cash generation, conditional on utilization, certification and competition; not subscription/contracted recurring revenue. Defense includes OEM and aftermarket, so the Note 15 commercial aftermarket rows are not the entire aftermarket estimate.","prov":"cited","ref_id":"C498","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r3","label":"B04 Aftermarket margin/stability characterization","cells":[{"text":"Management Language","prov":"cited","ref_id":"C499","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.4: \u201cHistorically, these aftermarket revenues have produced a higher gross profit and have been more stable than net sales to original equipment manufacturers\u201d; aircraft life estimated approximately 25\u201330 years and product life cycle in excess of 50 years. S1 p.9 explicitly says commercial aftermarket historically produced higher gross profit margins than commercial OEM.","prov":"cited","ref_id":"C499","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Long platform lives can spread replacement consumption across cycles; channel-mix shifts still move margins \u2192 historical resilience is a business mitigant, not a guaranteed margin or forward cash-flow floor. Aftermarket standalone gross margin: Not disclosed; no invented margin spread.","prov":"cited","ref_id":"C499","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r4","label":"B05 End markets / concentration","cells":[{"text":"Management Language","prov":"cited","ref_id":"C500","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.7 estimates FY2024 commercial/regional/business/general aviation aftermarket approximately 31%, commercial aerospace OEM approximately 27%, defense approximately 40%, non-aerospace approximately 2%; \u201cOur top ten customers ... approximately 42%\u201d; \u201cNone ... greater than 10%.\u201d Note 3 p.121 separately states no customer individually accounted for 10% or more in any supplied annual year.","prov":"cited","ref_id":"C500","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Customer breadth tempers individual counterparty dependence, but common aerospace/defense drivers can correlate demand \u2192 monitor sector/platform and distributor exposures beyond single-customer thresholds. Approximate narratives are not exact segment-account reconciliations; boundary wording at the threshold is preserved.","prov":"cited","ref_id":"C500","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r5","label":"B06 Geography","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C501","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.143: \u201cNet sales are measured based on the geographic destination of sales.\u201d FY2024/FY2023/FY2022 United States sales 5,032/4,265/3,496; foreign 2,908/2,320/1,933 (USD millions). S1 p.121: foreign customers \u201cprimarily in Western Europe, Canada and Asia.\u201d","prov":"cited","ref_id":"C501","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Destination diversity broadens demand sources but adds FX, export and cross-border operating exposures \u2192 do not infer functional-currency exposure, unrestricted foreign cash or legal asset location from customer geography. Individual-country detail: Not disclosed as material.","prov":"cited","ref_id":"C501","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r6","label":"B07 Customers / routes to market","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C502","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 pp.5\u20137 list OEMs, system suppliers, airlines, maintenance providers, military agencies/depots and distributors. S1 p.6: \u201cWe also use a number of distributors to provide logistical support\u201d; Boeing Distribution Services and Satair are named major distributors.","prov":"cited","ref_id":"C502","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Direct technical selling and distributor channels connect installed-base demand to orders; distributor stocking can distort near-term shipments \u2192 customer sales are not automatically end-user consumption, and quoted concentration is not platform concentration. Distributor-specific sales: Not disclosed.","prov":"cited","ref_id":"C502","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r7","label":"B08 Revenue recognition / visibility","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C503","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.120: \u201cA substantial portion ... revenue is recorded at a point in time basis\u201d; limited customized contracts recognize over time using cost-to-cost inputs. S1 p.121 elects not to disclose remaining performance obligations for contracts with original duration of one year or less.","prov":"cited","ref_id":"C503","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Point-in-time sales depend on shipments/control transfer; some over-time sales introduce estimation and contract-asset timing \u2192 avoid calling installed-base opportunity backlog or contractual revenue cover. Backlog/order coverage measure: Not disclosed in these passages.","prov":"cited","ref_id":"C503","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r8","label":"B09 Operating driver \u2014 pricing","cells":[{"text":"Management Language","prov":"cited","ref_id":"C504","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 pp.4, 6 describes \u201cpricing our highly engineered value-added products to fairly reflect the value we provide\u201d; p.7 says certification/development investments \u201cmay create disincentives for potential new competitors.\u201d","prov":"cited","ref_id":"C504","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Qualification costs may slow switching and permit pricing, while regulatory/customer scrutiny may constrain it \u2192 do not assume unlimited pricing power or classify all sales as sole-source. Price/volume decomposition and sole-source share: Not disclosed.","prov":"cited","ref_id":"C504","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r9","label":"B10 Operating driver \u2014 volumes","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C505","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.7: commercial aftermarket demand depends on installed base, RPKs, fleet age/size, warranty mix and airline profitability; defense depends on budgets, campaigns and political pressures. S1 p.8: \u201cshipments and revenues generally run ahead of aircraft delivery schedules\u201d; p.9 describes order/inventory and strike disruptions.","prov":"cited","ref_id":"C505","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Utilization drives spares; OEM build rates drive initial equipment with timing leads; budget releases drive defense \u2192 distinguish these cash-flow paths in stress work rather than extrapolate one consolidated growth rate. Historical discussion of fiscal 2025 indicators is not adopted as a forecast.","prov":"cited","ref_id":"C505","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r10","label":"B11 Operating driver \u2014 cost / manufacturing","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C506","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 p.6: approximately 120 manufacturing facilities, cross-functional product teams, engineering in cost of sales and selling/admin, R&D in selling/admin. S1 p.9: certification processes \u201ccould prevent efficient replacement of a supplier, raw material or component part.\u201d","prov":"cited","ref_id":"C506","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Decentralized product accountability supports cost response, but qualified supply chains and specialized labor constrain substitution \u2192 supply interruption and cost inflation can impair margins and working capital even where demand persists. Fixed/variable cost split and unit costs: Not disclosed.","prov":"cited","ref_id":"C506","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r11","label":"B12 Operating driver \u2014 capex","cells":[{"text":"Analyst Interpretation","prov":"cited","ref_id":"C507","gap_ref":null,"unit_class":"text","state":"known"},{"text":"CP-1 CF23 signed capex and K02 retained below; S1 p.6 describes equipment, tooling, IT/cybersecurity and automation investment; S1 p.142 reports segment capex.","prov":"cited","ref_id":"C507","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Cash capex is modest relative to reported operating cash in these periods, but acquisition spend is outside capex/FCF \u2192 historical CFO less capex is not cash available for equity or debt reduction after acquisitions. Maintenance/growth split: Not disclosed; measure Not supplied.","prov":"cited","ref_id":"C507","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r12","label":"B13 Operating driver \u2014 working capital","cells":[{"text":"Analyst Interpretation","prov":"cited","ref_id":"C508","gap_ref":null,"unit_class":"text","state":"known"},{"text":"CP-1 CF15\u2013CF21/K03 retains annual cash-use block; S1 p.121 defines contract assets as performance in advance of billing and liabilities as advance receipts; \u201cpayment terms vary by the type and location of the customer.\u201d","prov":"cited","ref_id":"C508","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Inventory/receivable and unbilled performance absorb cash before collection; advances offset some funding need \u2192 earnings growth does not convert one-for-one into liquidity. Exact turns, payment-day targets, seasonal peak requirement: Not disclosed. No acquisition-affected balance change substituted for cash-flow movements.","prov":"cited","ref_id":"C508","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"},{"row_id":"r13","label":"B14 Regulatory / labor exposures","cells":[{"text":"Documentary Fact","prov":"cited","ref_id":"C509","gap_ref":null,"unit_class":"text","state":"known"},{"text":"S1 pp.7\u20138: U.S. Government can suspend/terminate contracts, audit fees and seek repayment; FAA/EASA and OEM certification required. S1 p.10 says approximately 17% of full-/part-time employees union represented.","prov":"cited","ref_id":"C509","gap_ref":null,"unit_class":"text","state":"known"},{"text":"Qualification creates a barrier but also compliance cost and potential supply interruption; government remedies may reduce revenue/cash receipts \u2192 monitor enforcement and labor events without inventing a dated adverse regulatory or rating action.","prov":"cited","ref_id":"C509","gap_ref":null,"unit_class":"text","state":"known"}],"style":"row"}],"lines":[],"chart":null,"figures":[],"tab_label":null,"tabs":[],"note":null,"full_analysis_route":"CP-1A","route_label":null,"width":"full","numbered":false,"pinned":false,"meta":null,"summary":null,"groups":[],"base_column":null,"absent_columns":[]},{"block_id":"model-chart-strip","title":"Model char